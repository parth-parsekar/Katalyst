{
  "manifest_version": 3,
  "name": "Katalyst - Unified Learning Tracker",
  "version": "1.0.0",
  "description": "Track, organize, and timestamp your learning resources from YouTube, LeetCode, W3Schools, and the web in one sleek place.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "identity"
  ],
  "oauth2": {
    "client_id": "879958487653-k4t24q8c1dvop1d9clus7r4oa2ijh8qr.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "host_permissions": [
    "https://katalyst-fybi.onrender.com/*",
    "https://www.youtube.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Katalyst Tracker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content_script.js"
      ]
    }
  ]
}